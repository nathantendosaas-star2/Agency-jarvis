# Local development defaults
NODE_ENV=development
PORT=10000

# Generate a real bcrypt hash with: npm run hash-password
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Supabase (server-side secret only; never expose in browser code)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Tavily
TAVILY_API_KEY=

# SMTP: safe local development mode prevents real delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_DEV_MODE=true

# Buffer GraphQL API key
BUFFER_ACCESS_TOKEN=

# Google Sheets Apps Script webhook
GOOGLE_SHEETS_SCRIPT_URL=
GOOGLE_SHEETS_API_SECRET=
