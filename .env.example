# Server Configuration
NODE_ENV=production
PORT=10000

# Authentication & Session Security
# Generate hash using: npm run hash-password
ADMIN_PASSWORD_HASH=$2a$10$abcdefghijklmnopqrstuvwxyz012345678901234567890123456789
SESSION_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# Supabase PostgreSQL Database (Backend only - never expose on frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenRouter AI Gateway
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Tavily Business Research Search
TAVILY_API_KEY=tvly-your-tavily-key

# Outbound SMTP Email Configuration
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-agency-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=outreach@your-agency-domain.com
# Set to true for safe local testing without sending real emails
SMTP_DEV_MODE=false

# Buffer Social Media Publishing
BUFFER_ACCESS_TOKEN=your-buffer-access-token

# Google Sheets Ingestion (Google Apps Script Web App)
GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEETS_API_SECRET=your-shared-webhook-secret
