NODE_ENV=development
PORT=10000

# Step 2: Authentication
# Generate with: npm run hash-password
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Step 3: Supabase PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Step 4: Google Sheets Lead Ingestion
GOOGLE_SHEETS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEETS_API_SECRET=your_google_sheets_secret

# Step 5: AI and Research (OpenRouter + Tavily)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
TAVILY_API_KEY=your_tavily_api_key

# Outreach (Step 6)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Social publishing (Step 7)
BUFFER_ACCESS_TOKEN=
