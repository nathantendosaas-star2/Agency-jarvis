# Local development defaults
NODE_ENV=development
PORT=10000

# Generate a real bcrypt hash with: npm run hash-password
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Supabase (server-side secret only; never expose in browser code)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider: gemini (default) or openrouter
AI_PROVIDER=gemini

# Google Gemini (primary orchestrator)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Supported model choices:
# gemini-3.5-flash-lite (default for outreach and autonomous pipeline)
# gemini-3.8-flash
# gemini-3.6-flash

# Frontend & CORS Configuration (Render Backend & Netlify Frontend)
# Set FRONTEND_URL to your deployed Netlify domain in production (e.g. https://agency-jarvis.netlify.app)
FRONTEND_URL=
# API base URL for frontend client (leave blank for same-origin proxy or set backend URL)
API_BASE_URL=

# OpenRouter (optional alternative provider)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Tavily
TAVILY_API_KEY=

# SMTP email delivery (Gmail example: smtp.gmail.com, port 587, secure=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Agency Jarvis

# Bird sending is disabled; SMTP is the active outbound email provider.

# Buffer GraphQL API key
BUFFER_ACCESS_TOKEN=

# Google Sheets Apps Script webhook
GOOGLE_SHEETS_SCRIPT_URL=
GOOGLE_SHEETS_API_SECRET=
